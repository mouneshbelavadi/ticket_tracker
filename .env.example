# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase secret service-role key (server-only, bypasses RLS, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend API key for sending availability and trouble email alerts
RESEND_API_KEY=re_your_resend_api_key

# Destination email address (Gmail) where alerts will be delivered
NOTIFY_EMAIL=your-email@gmail.com

# Passphrase for single-user authentication into the portal dashboard
ADMIN_PASSWORD=admin

# Random 32+ character string used to cryptographically sign session cookies (e.g. via openssl rand -hex 32)
SESSION_SECRET=your-random-session-secret-at-least-32-chars

# Secret bearer token expected in Authorization header for GET /api/tick
CRON_SECRET=your-random-cron-secret-at-least-16-chars

# Base public URL of your deployed application (e.g. https://ticket-alert.vercel.app or http://localhost:3000)
APP_URL=http://localhost:3000

# Optional: Telegram Bot token from @BotFather for mobile push notifications
TELEGRAM_BOT_TOKEN=

# Optional: Telegram numeric chat ID to receive mobile push notifications
TELEGRAM_CHAT_ID=

# Optional: Allow fetching localhost/private IPs during local development testing (true/false)
ALLOW_LOCALHOST_FOR_DEV=false
